<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>AssetHealth EPS</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--navy:#0B2545;--blue:#1565C0;--sky:#E3EEFB;--bg:#F3F6FA;--card:#fff;--tx:#14233A;--mut:#5B6B80;--bd:#D8E0EA;--ok:#1B7F5C;--warn:#B26A00;--err:#B3261E;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root:not([data-theme="light"]){}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0C1626;--card:#14233A;--tx:#E6EDF6;--mut:#9FB0C6;--bd:#27395A;--sky:#1B2F52}}
:root[data-theme="dark"]{--bg:#0C1626;--card:#14233A;--tx:#E6EDF6;--mut:#9FB0C6;--bd:#27395A;--sky:#1B2F52}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.5 "IBM Plex Sans",system-ui,Segoe UI,sans-serif}
button,input,select,textarea{font:inherit}
h1{font-size:22px;margin:0 0 16px}h2{font-size:16px;margin:0 0 12px}
.btn{border:0;background:var(--blue);color:#fff;padding:9px 14px;border-radius:6px;cursor:pointer;min-height:40px}
.btn.s{background:var(--sky);color:var(--blue);padding:6px 10px;min-height:34px;font-size:13px}
.btn.g{background:transparent;color:var(--mut);border:1px solid var(--bd)}
:focus-visible{outline:3px solid #6AA9F5;outline-offset:2px}
input,select,textarea{width:100%;padding:9px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--card);color:var(--tx);min-height:40px}
label{display:block;font-size:13px;color:var(--mut);margin:10px 0 4px}
#login{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(160deg,var(--navy),#12407A)}
.lbox{background:var(--card);padding:28px;border-radius:10px;width:100%;max-width:380px}
.brand{font-weight:600;font-size:20px;color:var(--navy)}.brand b{color:var(--blue)}
@media(prefers-color-scheme:dark){.brand{color:#fff}}
.hint{font-size:12.5px;color:var(--mut);margin-top:14px;border-top:1px solid var(--bd);padding-top:10px}
#app{display:none;min-height:100vh}
aside{position:fixed;inset:0 auto 0 0;width:230px;background:var(--navy);color:#C9D8EC;padding:18px 12px;overflow:auto;z-index:20}
aside .brand{color:#fff;padding:0 8px 16px}aside .brand b{color:#7DB4F5}
nav button{display:block;width:100%;text-align:left;background:none;border:0;color:inherit;padding:11px 10px;border-radius:6px;cursor:pointer;min-height:44px}
nav button:hover,nav button.on{background:#17407A;color:#fff}
main{margin-left:230px;padding:22px;max-width:1280px}
.top{display:none}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.bar>*{flex:1 1 160px}.bar .btn{flex:0 0 auto}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:14px}
.kpi small{color:var(--mut)}.kpi div{font-size:28px;font-weight:600;color:var(--blue)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}
.row{display:grid;grid-template-columns:110px 1fr 28px;gap:8px;align-items:center;font-size:13px;margin:6px 0}
.row i{display:block;height:10px;background:var(--blue);border-radius:3px}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--bd);border-radius:8px;overflow:hidden}
th,td{padding:10px;text-align:left;border-bottom:1px solid var(--bd);vertical-align:middle}th{background:var(--sky);font-size:13px;font-weight:600}
td.a{display:flex;gap:6px;flex-wrap:wrap}
.tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:12.5px;background:var(--sky);color:var(--blue)}
.tag.Disponible{background:#DDF3EA;color:var(--ok)}.tag.Perdido,.tag.Alta,.tag.Vencido{background:#F9DEDC;color:var(--err)}
.tag.Mantenimiento,.tag.Media{background:#FCEBD0;color:var(--warn)}
.tl{border-left:3px solid var(--blue);margin:8px 0 0 6px;padding-left:16px}.tl div{margin-bottom:14px;position:relative}
.tl div:before{content:"";position:absolute;left:-23px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--blue)}
.tl small{color:var(--mut)}
dialog{border:0;border-radius:10px;padding:20px;width:min(460px,94vw);background:var(--card);color:var(--tx)}
dialog::backdrop{background:#0008}
.acts{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);padding:12px 16px;border-radius:8px;color:#fff;z-index:50;max-width:92vw;display:none}
.det{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px 16px}.det small{display:block;color:var(--mut)}
@media(max-width:860px){
 aside{transform:translateX(-100%);transition:transform .2s}aside.open{transform:none}
 main{margin-left:0;padding:14px}
 .top{display:flex;align-items:center;gap:10px;background:var(--navy);color:#fff;padding:10px 14px;position:sticky;top:env(safe-area-inset-top,0px);z-index:10}
 .top button{background:none;border:0;color:#fff;font-size:24px;min-width:44px;min-height:44px}
 .two{grid-template-columns:1fr}
 table,thead,tbody,tr,td{display:block;width:100%}thead{display:none}
 table{border:0;background:none}
 tr{background:var(--card);border:1px solid var(--bd);border-radius:8px;margin-bottom:10px;padding:6px 10px}
 td{border:0;padding:5px 0;display:flex;justify-content:space-between;gap:10px;text-align:right}
 td:before{content:attr(data-l);color:var(--mut);text-align:left}
 td.a{justify-content:flex-start}td.a:before{display:none}
 .btn.s{min-height:44px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div id="login"><form class="lbox" onsubmit="return doLogin(event)">
 <div class="brand">Asset<b>Health</b> EPS</div><p style="color:var(--mut);margin:4px 0 8px">Control y trazabilidad de equipos médicos y tecnológicos</p>
 <label for="u">Usuario o correo</label><input id="u" autocomplete="username">
 <label for="p">Contraseña</label><input id="p" type="password" autocomplete="current-password">
 <div id="lerr" style="color:var(--err);font-size:13px;min-height:20px;margin-top:6px"></div>
 <button class="btn" style="width:100%">Iniciar sesión</button>
 <div class="hint">Credenciales de prueba (demo): admin / Admin123* · custodio / Custodio123* · tecnico / Tecnico123* · auditor / Auditor123*</div>
</form></div>
<div id="app">
 <div class="top"><button onclick="document.querySelector('aside').classList.toggle('open')" aria-label="Menú">☰</button><span class="brand" style="color:#fff">Asset<b style="color:#7DB4F5">Health</b></span></div>
 <aside><div class="brand">Asset<b>Health</b> EPS</div><nav id="nav"></nav></aside>
 <main id="main"></main>
</div>
<dialog id="dlg"></dialog><div id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),iso=n=>{const d=new Date();d.setDate(d.getDate()+n);return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")};
const HOY=iso(0),esc=x=>String(x??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const S={
 sedes:[{id:1,n:"Bogotá Norte",c:"BN",ciu:"Bogotá",act:1},{id:2,n:"Bogotá Centro",c:"BC",ciu:"Bogotá",act:1},{id:3,n:"Medellín",c:"MD",ciu:"Medellín",act:1}],
 users:[{u:"admin",p:"Admin123*",n:"Ana Ruiz",rol:"Administrador",act:1},{u:"custodio",p:"Custodio123*",n:"Juan Pérez",rol:"Custodio",act:1},{u:"tecnico",p:"Tecnico123*",n:"Carlos Gómez",rol:"Técnico",act:1},{u:"auditor",p:"Auditor123*",n:"Marta Silva",rol:"Auditor",act:1},{u:"lgomez",p:"x",n:"Laura Gómez",rol:"Custodio",act:0}],
 assets:[
 ["AH-001","Monitor de signos vitales","Biomédico","Philips","MX450","SN7781","Disponible",1,"UCI",90,"770100001","RF-A1",""],
 ["AH-002","Ventilador mecánico","Biomédico","Dräger","V500","SN2290","En préstamo",1,"Urgencias",400,"770100002","RF-A2","Juan Pérez"],
 ["AH-003","Portátil clínico","Informático","Lenovo","T14","SN5541","Asignado",2,"Admisiones",20,"770100003","","Juan Pérez"],
 ["AH-004","Desfibrilador","Biomédico","Zoll","R-Series","SN1203","En mantenimiento",2,"Quirófano",200,"770100004","RF-A4",""],
 ["AH-005","Bomba de infusión","Biomédico","B. Braun","Space","SN3318","Disponible",3,"Hospitalización",25,"770100005","RF-A5",""],
 ["AH-006","Tablet de enfermería","Tecnológico","Samsung","Tab A8","SN9902","Perdido",3,"—",300,"770100006","",""],
 ["AH-007","Electrocardiógrafo","Biomédico","GE","MAC 2000","SN4410","Disponible",1,"Consulta externa",500,"770100007","RF-A7",""]
 ].map((a,i)=>({id:i+1,cod:a[0],nom:a[1],tipo:a[2],marca:a[3],mod:a[4],serie:a[5],estado:a[6],sede:a[7],ubi:a[8],gar:iso(a[9]),barras:a[10],rfid:a[11],cust:a[12]})),
 loans:[{id:1,a:2,f:"Juan Pérez",ini:iso(-6),prev:iso(2),real:null,est:"Activo"}],
 maint:[{id:1,a:4,tec:"Carlos Gómez",tipo:"Correctivo",desc:"No carga la batería",est:"En proceso",res:""}],
 ev:[]
};
let keepScroll=0,me=null,view="dash",f={q:"",st:""},n=0;
const sede=id=>S.sedes.find(s=>s.id==id)?.n||"—",A=id=>S.assets.find(a=>a.id==id);
function log(a,accion,desc){S.ev.push({a:a.id,t:new Date(),u:me?me.n:"Sistema",accion,sede:sede(a.sede),desc:desc||""})}
S.assets.forEach(a=>{S.ev.push({a:a.id,t:new Date(Date.now()-864e5*9),u:"Ana Ruiz",accion:"Activo creado",sede:sede(a.sede),desc:""});
 if(a.cust)S.ev.push({a:a.id,t:new Date(Date.now()-864e5*6),u:"Ana Ruiz",accion:a.estado=="En préstamo"?"Préstamo registrado":"Activo asignado",sede:sede(a.sede),desc:"Custodio: "+a.cust});
 if(a.estado=="En mantenimiento")S.ev.push({a:a.id,t:new Date(Date.now()-864e5*2),u:"Carlos Gómez",accion:"Enviado a mantenimiento",sede:sede(a.sede),desc:"No carga la batería"})});

/* Regla de negocio (espejo de validar_prestamo del backend FastAPI) */
function validarPrestamo(activo,func,fechaDev){
 if(!activo)return"El activo no existe";
 if(activo.estado!=="Disponible")return"No se puede prestar: el activo está en estado «"+activo.estado+"»";
 if(!func)return"Funcionario no válido";
 if(!func.act)return"El funcionario no está habilitado";
 if(!fechaDev)return"Debe indicar una fecha de devolución";
 if(fechaDev<=HOY)return"La fecha de devolución no es válida";
 return"Préstamo autorizado"}

function toast(m,ok=true){const t=$("#toast");t.textContent=m;t.style.background=ok?"#1B7F5C":"#B3261E";t.style.display="block";clearTimeout(n);n=setTimeout(()=>t.style.display="none",4200)}
function doLogin(e){e.preventDefault();const u=$("#u").value.trim(),p=$("#p").value;
 if(!u||!p){$("#lerr").textContent="Ingrese usuario y contraseña.";return false}
 const x=S.users.find(x=>(x.u==u)&&x.p==p);
 if(!x||!x.act){$("#lerr").textContent="Credenciales inválidas o usuario inactivo.";return false}
 me=x;$("#login").style.display="none";$("#app").style.display="block";view="dash";menu();render();return false}
function logout(){me=null;$("#app").style.display="none";$("#login").style.display="grid";$("#p").value="";$("#lerr").textContent=""}
const R=()=>me.rol, isAdm=()=>R()=="Administrador", canMant=()=>isAdm()||R()=="Técnico";
function menu(){const m=[["dash","▦ Dashboard"],["activos","📦 Inventario"],["prestamos","🔄 Préstamos"],["mant","🔧 Mantenimiento"],["alertas","⚠ Alertas"]];
 if(isAdm()||R()=="Auditor")m.push(["sedes","🏢 Sedes"],["usuarios","👥 Usuarios"],["reportes","📊 Reportes"]);
 $("#nav").innerHTML=m.map(([k,l])=>`<button data-k="${k}" onclick="go('${k}')">${l}</button>`).join("")+`<button onclick="logout()">🚪 Cerrar sesión</button><div style="padding:14px 10px;font-size:12px">${me.n}<br>${me.rol}</div>`}
function go(k){view=k;document.querySelector("aside").classList.remove("open");render()}
function mine(){return R()=="Custodio"?S.assets.filter(a=>a.cust==me.n):S.assets}
function alertas(){const o=[];
 S.loans.filter(l=>l.est=="Activo").forEach(l=>{const a=A(l.a);if(l.prev<HOY)o.push(["Préstamo vencido",a,"Alta",l.f]);else if(l.prev<=iso(3))o.push(["Préstamo próximo a vencer",a,"Media",l.f])});
 S.assets.forEach(a=>{if(a.estado=="En mantenimiento")o.push(["Activo en mantenimiento",a,"Media","Técnico"]);
  if(a.estado=="Perdido")o.push(["Activo reportado perdido",a,"Alta",a.cust||"Administrador"]);
  if(a.gar<=iso(60)&&a.gar>=HOY)o.push(["Garantía próxima a vencer ("+a.gar+")",a,"Media","Administrador"])});
 return R()=="Custodio"?o.filter(x=>x[1].cust==me.n):o}
const bars=(o)=>{const mx=Math.max(1,...Object.values(o));return Object.entries(o).map(([k,v])=>`<div class="row"><span>${k}</span><i style="width:${v/mx*100}%"></i><b>${v}</b></div>`).join("")};
const cnt=(l,fn)=>l.reduce((o,x)=>(o[fn(x)]=(o[fn(x)]||0)+1,o),{});
function render(){document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("on",b.dataset.k==view));
 $("#main").innerHTML=({dash,activos,prestamos,mant,alertas:vAl,sedes:vSed,usuarios:vUs,reportes:vRep})[view]();if(!keepScroll)window.scrollTo(0,0);keepScroll=0}
function dash(){const L=mine(),c=e=>L.filter(a=>a.estado==e).length,al=alertas();
 const k=[["Total de activos",L.length],["Disponibles",c("Disponible")],["Asignados",c("Asignado")],["En préstamo",c("En préstamo")],["En mantenimiento",c("En mantenimiento")],["Perdidos",c("Perdido")],["Alertas pendientes",al.length],["Préstamos por devolver",S.loans.filter(l=>l.est=="Activo"&&(R()!="Custodio"||l.f==me.n)).length]];
 return`<h1>Panel principal</h1><div class="grid">${k.map(x=>`<div class="card kpi"><small>${x[0]}</small><div>${x[1]}</div></div>`).join("")}</div>
 <div class="two"><div class="card"><h2>Activos por estado</h2>${bars(cnt(L,a=>a.estado))}</div><div class="card"><h2>Activos por sede</h2>${bars(cnt(L,a=>sede(a.sede)))}</div></div>`}
function activos(){const q=f.q.toLowerCase();
 const L=mine().filter(a=>(!f.st||a.estado==f.st)&&(!q||[a.cod,a.nom,a.serie,a.barras,a.rfid,a.cust].join(" ").toLowerCase().includes(q)));
 const sts=["Disponible","Asignado","En préstamo","En mantenimiento","Fuera de servicio","Perdido"];
 return`<h1>Inventario</h1><div class="bar"><input id="q" placeholder="Buscar por código, nombre, serie, código de barras, RFID o custodio" value="${esc(f.q)}" oninput="f.q=this.value;keep()" aria-label="Buscar">
 <select onchange="f.st=this.value;render()" aria-label="Estado"><option value="">Todos los estados</option>${sts.map(s=>`<option ${f.st==s?"selected":""}>${s}</option>`).join("")}</select>
 ${isAdm()?`<button class="btn" onclick="nuevo()">Registrar activo</button>`:""}</div>
 <table><thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th>Sede</th><th>Custodio</th><th>Acciones</th></tr></thead><tbody>
 ${L.map(a=>`<tr><td data-l="Código">${esc(a.cod)}</td><td data-l="Nombre">${esc(a.nom)}</td><td data-l="Tipo">${esc(a.tipo)}</td><td data-l="Estado"><span class="tag ${a.estado.split(" ").pop()}">${a.estado}</span></td><td data-l="Sede">${sede(a.sede)}</td><td data-l="Custodio">${esc(a.cust)||"—"}</td><td class="a">${acc(a)}</td></tr>`).join("")||`<tr><td>No hay activos con ese criterio. Pruebe otra búsqueda.</td></tr>`}</tbody></table>`}
function keep(){const p=$("#q").selectionStart;keepScroll=1;render();const e=$("#q");e.focus();e.setSelectionRange(p,p)}
function acc(a){let b=`<button class="btn s" onclick="ver(${a.id})">Ver / trazabilidad</button>`;
 if(isAdm()&&a.estado=="Disponible")b+=`<button class="btn s" onclick="prestar(${a.id})">Prestar</button><button class="btn s" onclick="trasladar(${a.id})">Trasladar</button>`;
 if(a.estado=="En préstamo"&&(isAdm()||a.cust==me.n))b+=`<button class="btn s" onclick="devolver(${a.id})">Devolver</button>`;
 if(canMant()&&a.estado=="Disponible")b+=`<button class="btn s" onclick="mantIni(${a.id})">Mantenimiento</button>`;
 if(canMant()&&a.estado=="En mantenimiento")b+=`<button class="btn s" onclick="mantFin(${a.id})">Finalizar mantenimiento</button>`;
 return b}
function modal(t,body,ok,fn){const d=$("#dlg");d.innerHTML=`<form method="dialog" onsubmit="return false"><h2>${t}</h2>${body}<div class="acts"><button class="btn g" onclick="$('#dlg').close()">${ok?"Cancelar":"Cerrar"}</button>${ok?`<button class="btn" id="okb">${ok}</button>`:""}</div></form>`;d.showModal();if(ok)$("#okb").onclick=()=>{if(fn()!==false)d.close()}}
const sel=(id,o)=>`<select id="${id}">${o.map(x=>`<option value="${x[0]}">${x[1]}</option>`).join("")}</select>`;
function ver(id){const a=A(id),ev=S.ev.filter(e=>e.a==id).sort((x,y)=>y.t-x.t);
 modal(esc(a.nom),`<div class="det">${[["Código",a.cod],["Tipo",a.tipo],["Marca / modelo",a.marca+" "+a.mod],["Serie",a.serie],["Estado",a.estado],["Sede",sede(a.sede)],["Ubicación",a.ubi],["Custodio actual",a.cust||"—"],["Garantía",a.gar],["Código de barras",a.barras],["RFID",a.rfid||"—"]].map(x=>`<div><small>${x[0]}</small>${esc(x[1])}</div>`).join("")}</div>
 <h2 style="margin-top:18px">Historial de trazabilidad</h2><div class="tl">${ev.map(e=>`<div><b>${e.accion}</b><br><small>${e.t.toLocaleString("es-CO")} · ${esc(e.u)} · ${esc(e.sede)}</small><br>${esc(e.desc)}</div>`).join("")}</div>`,null)}
function nuevo(){modal("Registrar activo",`<label>Código</label><input id="c"><label>Nombre</label><input id="n"><label>Tipo</label>${sel("t",["Biomédico","Informático","Tecnológico","Soporte asistencial"].map(x=>[x,x]))}<label>Marca</label><input id="m"><label>Número de serie</label><input id="s"><label>Sede</label>${sel("se",S.sedes.map(s=>[s.id,s.n]))}<label>Ubicación</label><input id="ub"><label>Fecha de garantía</label><input id="g" type="date">`,"Guardar activo",()=>{
 const v=i=>$("#"+i).value.trim();if(!v("c")||!v("n")||!v("s")||!v("g")){toast("Complete código, nombre, serie y garantía.",false);return false}
 if(S.assets.some(a=>a.cod==v("c")||a.serie==v("s"))){toast("Ya existe un activo con ese código o serie.",false);return false}
 const a={id:S.assets.length+1,cod:v("c"),nom:v("n"),tipo:v("t"),marca:v("m"),mod:"",serie:v("s"),estado:"Disponible",sede:+v("se"),ubi:v("ub"),gar:v("g"),barras:"77"+Date.now().toString().slice(-9),rfid:"",cust:""};
 S.assets.push(a);log(a,"Activo creado");toast("Activo registrado correctamente");render()})}
function prestar(id){const a=A(id);modal("Prestar: "+esc(a.nom),`<label>Funcionario</label>${sel("fu",S.users.filter(u=>u.rol=="Custodio").map(u=>[u.u,u.n+(u.act?"":" (inactivo)")]))}<label>Fecha prevista de devolución</label><input id="fd" type="date" value="${iso(7)}"><label>Motivo</label><input id="mo">`,"Registrar préstamo",()=>{
 const fu=S.users.find(u=>u.u==$("#fu").value),r=validarPrestamo(a,fu,$("#fd").value);
 if(r!=="Préstamo autorizado"){toast("⚠️ "+r,false);return false}
 S.loans.push({id:S.loans.length+1,a:a.id,f:fu.n,ini:HOY,prev:$("#fd").value,real:null,est:"Activo"});a.estado="En préstamo";a.cust=fu.n;
 log(a,"Préstamo registrado","Custodio: "+fu.n+" · devolución "+$("#fd").value);toast("Préstamo autorizado y registrado");render()})}
function devolver(id){const a=A(id);modal("Devolver: "+esc(a.nom),`<label>Estado del equipo</label>${sel("es",[["ok","Buen estado"],["nov","Con novedad (daño)"]])}<label>Observaciones</label><input id="ob">`,"Registrar devolución",()=>{
 const l=S.loans.find(l=>l.a==id&&l.est=="Activo");if(!l){toast("No existe un préstamo activo para este equipo.",false);return false}
 const nov=$("#es").value=="nov";l.est="Devuelto";l.real=HOY;const c=a.cust;a.cust="";a.estado=nov?"En mantenimiento":"Disponible";
 log(a,nov?"Devuelto con novedad":"Devuelto","Custodio liberado: "+c+" "+$("#ob").value);
 if(nov){S.maint.push({id:S.maint.length+1,a:id,tec:"Sin asignar",tipo:"Correctivo",desc:$("#ob").value||"Novedad en devolución",est:"Programado",res:""});log(a,"Enviado a mantenimiento","Por novedad en devolución")}
 toast(nov?"Devolución con novedad: el equipo pasó a mantenimiento":"Devolución registrada: equipo disponible");render()})}
function trasladar(id){const a=A(id);modal("Trasladar: "+esc(a.nom),`<label>Sede destino</label>${sel("sd",S.sedes.filter(s=>s.id!=a.sede).map(s=>[s.id,s.n]))}<label>Motivo</label><input id="mo">`,"Registrar traslado",()=>{
 if(!$("#mo").value.trim()){toast("Indique el motivo del traslado.",false);return false}
 const o=sede(a.sede);a.sede=+$("#sd").value;log(a,"Activo trasladado","Origen: "+o+" → Destino: "+sede(a.sede)+" · "+$("#mo").value);toast("Traslado registrado");render()})}
function mantIni(id){const a=A(id);modal("Mantenimiento: "+esc(a.nom),`<label>Tipo</label>${sel("ty",[["Preventivo","Preventivo"],["Correctivo","Correctivo"]])}<label>Descripción / problema</label><input id="de">`,"Iniciar mantenimiento",()=>{
 if(!$("#de").value.trim()){toast("Describa el mantenimiento.",false);return false}
 S.maint.push({id:S.maint.length+1,a:id,tec:me.n,tipo:$("#ty").value,desc:$("#de").value,est:"En proceso",res:""});a.estado="En mantenimiento";log(a,"Enviado a mantenimiento",$("#de").value);toast("Activo en mantenimiento");render()})}
function mantFin(id){const a=A(id);modal("Finalizar mantenimiento",`<label>Resultado</label><input id="re">`,"Finalizar",()=>{
 if(!$("#re").value.trim()){toast("Indique el resultado.",false);return false}
 const m=S.maint.find(m=>m.a==id&&m.est!="Finalizado");if(m){m.est="Finalizado";m.res=$("#re").value;m.tec=m.tec=="Sin asignar"?me.n:m.tec}
 a.estado="Disponible";log(a,"Mantenimiento finalizado",$("#re").value);toast("Mantenimiento finalizado: activo disponible");render()})}
function prestamos(){const L=S.loans.filter(l=>R()!="Custodio"||l.f==me.n);
 return`<h1>Préstamos y devoluciones</h1><table><thead><tr><th>Activo</th><th>Funcionario</th><th>Préstamo</th><th>Devolución prevista</th><th>Estado</th><th></th></tr></thead><tbody>${L.map(l=>{const a=A(l.a),v=l.est=="Activo"&&l.prev<HOY;
 return`<tr><td data-l="Activo">${esc(a.nom)}</td><td data-l="Funcionario">${esc(l.f)}</td><td data-l="Préstamo">${l.ini}</td><td data-l="Prevista">${l.prev}</td><td data-l="Estado"><span class="tag ${v?"Vencido":l.est}">${v?"Vencido":l.est}</span></td><td class="a">${l.est=="Activo"&&(isAdm()||l.f==me.n)?`<button class="btn s" onclick="devolver(${a.id})">Devolver</button>`:""}</td></tr>`}).join("")||`<tr><td>Sin préstamos registrados. Registre uno desde el inventario.</td></tr>`}</tbody></table>`}
function mant(){return`<h1>Mantenimiento</h1><table><thead><tr><th>Activo</th><th>Tipo</th><th>Técnico</th><th>Descripción</th><th>Estado</th><th>Resultado</th></tr></thead><tbody>${S.maint.map(m=>`<tr><td data-l="Activo">${esc(A(m.a).nom)}</td><td data-l="Tipo">${m.tipo}</td><td data-l="Técnico">${esc(m.tec)}</td><td data-l="Descripción">${esc(m.desc)}</td><td data-l="Estado"><span class="tag">${m.est}</span></td><td data-l="Resultado">${esc(m.res)||"—"}</td></tr>`).join("")}</tbody></table>`}
function vAl(){const L=alertas();return`<h1>Alertas</h1><table><thead><tr><th>Tipo</th><th>Activo</th><th>Prioridad</th><th>Responsable</th></tr></thead><tbody>${L.map(x=>`<tr><td data-l="Tipo">${x[0]}</td><td data-l="Activo">${esc(x[1].cod)} · ${esc(x[1].nom)}</td><td data-l="Prioridad"><span class="tag ${x[2]}">${x[2]}</span></td><td data-l="Responsable">${esc(x[3])}</td></tr>`).join("")||`<tr><td>Sin alertas pendientes.</td></tr>`}</tbody></table>`}
function vSed(){return`<h1>Sedes</h1><table><thead><tr><th>Código</th><th>Nombre</th><th>Ciudad</th><th>Activos</th></tr></thead><tbody>${S.sedes.map(s=>`<tr><td data-l="Código">${s.c}</td><td data-l="Nombre">${s.n}</td><td data-l="Ciudad">${s.ciu}</td><td data-l="Activos">${S.assets.filter(a=>a.sede==s.id).length}</td></tr>`).join("")}</tbody></table>`}
function vUs(){return`<h1>Usuarios</h1><table><thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Estado</th></tr></thead><tbody>${S.users.map(u=>`<tr><td data-l="Nombre">${u.n}</td><td data-l="Usuario">${u.u}</td><td data-l="Rol">${u.rol}</td><td data-l="Estado"><span class="tag ${u.act?"Disponible":"Perdido"}">${u.act?"Activo":"Inactivo"}</span></td></tr>`).join("")}</tbody></table>`}
function vRep(){return`<h1>Reportes</h1><div class="two"><div class="card"><h2>Inventario por estado</h2>${bars(cnt(S.assets,a=>a.estado))}</div><div class="card"><h2>Inventario por sede</h2>${bars(cnt(S.assets,a=>sede(a.sede)))}</div></div><button class="btn" onclick="csv()">Exportar inventario (CSV)</button>`}
function csv(){const r=[["Código","Nombre","Tipo","Estado","Sede","Custodio"],...S.assets.map(a=>[a.cod,a.nom,a.tipo,a.estado,sede(a.sede),a.cust])];
 const b=new Blob(["\ufeff"+r.map(x=>x.join(";")).join("\n")],{type:"text/csv"});const l=document.createElement("a");l.href=URL.createObjectURL(b);l.download="inventario.csv";l.click()}
</script>
</body>
</html>
